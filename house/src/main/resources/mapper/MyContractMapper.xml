<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qy.mapper.house.MyContractMapper">
    <insert id="insertContract" parameterType="com.qy.domain.pojo.ContractPojo">
        insert into contracts
        <trim prefix="(" suffixOverrides="," suffix=")">
            <if test="houseId!=null">house_id,</if>
            <if test="tenantId!=null">tenant_id,</if>
            <if test="landlordId!=null">landlord_id,</if>
            <if test="startDate!=null and startDate!=''">start_date,</if>
            <if test="endDate!=null and endDate!=''">end_date,</if>
            <if test="rentAmount!=null">rent_amount,</if>
            <if test="depositAmount!=null">deposit_amount,</if>
            <if test="status!=null and status!=''">status,</if>
            <if test="contractFile!=null and contractFile!=''">contract_file,</if>
            <if test="updateAt!=null and updateAt!=''">update_at,</if>
            <if test="createAt!=null and createAt!=''">create_at,</if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="houseId!=null">#{house_id},</if>
            <if test="tenantId!=null">#{tenant_id},</if>
            <if test="landlordId!=null">#{landlord_id},</if>
            <if test="startDate!=null and startDate!=''">#{start_date},</if>
            <if test="endDate!=null and endDate!=''">#{end_date},</if>
            <if test="rentAmount!=null">#{rent_amount},</if>
            <if test="depositAmount!=null">#{deposit_amount},</if>
            <if test="status!=null and status!=''">#{status},</if>
            <if test="contractFile!=null and contractFile!=''">#{contract_file},</if>
            <if test="updateAt!=null and updateAt!=''">#{update_at},</if>
            <if test="createAt!=null and createAt!=''">#{create_at},</if>
        </trim>
    </insert>
    <update id="updateContract" parameterType="com.qy.domain.pojo.ContractPojo">
        update contracts set
        <trim prefix="(" suffixOverrides="," suffix=")">
            <if test="startDate!=null and startDate!=''">start_date=#{startDate},</if>
            <if test="endDate!=null and endDate!=''">end_date=#{endDate},</if>
            <if test="rentAmount!=null">rent_amount=#{rentAmount},</if>
            <if test="depositAmount!=null">deposit_amount=#{depositAmount},</if>
            <if test="status!=null and status!=''">status=#{status},</if>
            <if test="contractFile !=null and contractFile!=''">contract_file=#{contractFile},</if>
            <if test="createdAt!=null and created!=''">create_at=#{createdAt},</if>
            <if test="updatedAt!=null and updated!=''">update_at=#{updatedAt},</if>
        </trim>
    </update>
    <select id="selectContractsByTenantId" resultType="com.qy.domain.pojo.ContractPojo">
        select * from contracts where tenant_id=#{userId}
    </select>
    <select id="selectContractsByLandordId" resultType="com.qy.domain.pojo.ContractPojo">
        select * from contracts where landlord_id=#{userId}
    </select>
</mapper>