<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qy.mapper.house.MyHouseMapper">
    <insert id="insertHousePojo" parameterType="com.qy.domain.pojo.HousePojo">
        insert into houses
        <trim prefix="(" suffixOverrides="," suffix=")">
            <if test="title!=null and title!=''">title,</if>
            <if test="rent!=null">rent,</if>
            <if test="deposit!=null and deposit!=''">deposit,</if>
            <if test="type!=null and type!=''">type,</if>
            <if test="area!=null and area!=''">area,</if>
            <if test="rooms!=null and rooms!=''">rooms,</if>
            <if test="district!=null and district!=''">district,</if>
            <if test="address!=null and address!=''">address,</if>
            <if test="contact!=null and contact!=''">contact,</if>
            <if test="description!=null and description!=''">description,</if>
            <if test="facillities!=null and facillities!=''">facillities,</if>
            <if test="images!=null and images!=''">images,</if>
            <if test="landlordId!=null and landlordId!=''">landlord_id,</if>
            <if test="status!=null and status!=''">status,</if>
            <if test="viewCount!=null and viewCount!=''">view_count,</if>
            <if test="updatedAt!=null and updatedAt!=''">updated_at,</if>
        </trim>
            values
        <trim prefix="(" suffixOverrides="," suffix=")">
            <if test="title!=null and title!=''">#{title},</if>
            <if test="rent!=null">#{rent},</if>
            <if test="deposit!=null and deposit!=''">#{deposit},</if>
            <if test="type!=null and type!=''">#{type},</if>
            <if test="area!=null and area!=''">#{area},</if>
            <if test="rooms!=null and rooms!=''">#{rooms},</if>
            <if test="district!=null and district!=''">#{district},</if>
            <if test="address!=null and address!=''">#{address},</if>
            <if test="contact!=null and contact!=''">#{contact},</if>
            <if test="description!=null and description!=''">#{description},</if>
            <if test="facillities!=null and facillities!=''">#{facillities},</if>
            <if test="images!=null and images!=''">#{images},</if>
            <if test="landlordId!=null and landlordId!=''">#{landlordId},</if>
            <if test="status!=null and status!=''">#{status},</if>
            <if test="viewCount!=null and viewCount!=''">#{viewCount},</if>
            <if test="updatedAt!=null and updatedAt!=''">#{updatedAt},</if>
        </trim>
    </insert>
    <update id="updateHousePojo">
        update houses set
        <trim prefix="(" suffixOverrides="," suffix=")">
            <if test="title!=null and title!=''">title=#{title},</if>
            <if test="rent!=null">rent=#{rent},</if>
            <if test="deposit!=null and deposit!=''">deposit=#{deposit},</if>
            <if test="type!=null and type!=''">type=#{type},</if>
            <if test="area!=null and area!=''">area=#{area},</if>
            <if test="rooms!=null and rooms!=''">rooms=#{rooms},</if>
            <if test="district!=null and district!=''">district=#{district},</if>
            <if test="address!=null and address!=''">address=#{address},</if>
            <if test="contact!=null and contact!=''">contact=#{contact},</if>
            <if test="description!=null and description!=''">description=#{description},</if>
            <if test="facillities!=null and facillities!=''">facillities=#{facillities},</if>
            <if test="images!=null and images!=''">images=#{images},</if>
            <if test="landlordId!=null and landlordId!=''">landlord_id=#{facillities},</if>
            <if test="status!=null and status!=''">status=#{status},</if>
            <if test="viewCount!=null and viewCount!=''">view_count=#{viewCount},</if>
            <if test="updatedAt!=null and updatedAt!=''">updated_at=#{updatedAt},</if>
        </trim>
        where id=#{id}
    </update>
    <delete id="deleteHouseById">
        delete houses where id=#{id}
    </delete>
    <select id="searchHouse" resultType="com.qy.domain.pojo.HousePojo">
        select * from houses
        <where>
            <if test="district!=null">and district like concat('%', #{district}, '%') </if>
            <if test="rentMin!=null and rentMax!=null">and rent between #{rentMin} and #{rentMax}</if>
            <if test="type!=null and type!=''">and type =#{type}</if>
        </where>
        limit #{offNum},#{pageSize}
    </select>
    <select id="selectHouseById" resultType="com.qy.domain.pojo.HousePojo">
        select * from houses
        where id=#{id}
    </select>
</mapper>