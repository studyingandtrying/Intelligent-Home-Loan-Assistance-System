<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qy.mapper.house.MyAppointMentMapper">
    <insert id="insertAppointMent" parameterType="com.qy.domain.pojo.AppointMentPojo">
        insert into appointments
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="houseId!=null">house_id</if>
            <if test="tenantId!=null">tenant_id</if>
            <if test="landlordId!=null">landlord_id</if>
            <if test="appointmentTime!=null and appointmentTime!=''">appointment_time</if>
            <if test="contactName!=null and contactName!=''">contact_name</if>
            <if test="contactPhone!=null and contactPhone!=''">contact_phone</if>
            <if test="remark!=null and remark!=''">remark</if>
            <if test="status!=null and status!=''">status</if>
            <if test="rejectReason!=null and rejectReason!=''">reject_reason</if>
            <if test="createdAt!=null and createdAt!=''">created_at</if>
            <if test="updatedAt!=null and updatedAt!=''">updated_at</if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="houseId!=null">#{#{houseId}</if>
            <if test="tenantId!=null">#{tenantId}</if>
            <if test="landlordId!=null">#{landlordId}</if>
            <if test="appointmentTime!=null and appointmentTime!=''">#{appointmentTime}</if>
            <if test="contactName!=null and contactName!=''">#{contactName}</if>
            <if test="contactPhone!=null and contactPhone!=''">#{contactPhone}</if>
            <if test="remark!=null and remark!=''">#{remark}</if>
            <if test="status!=null and status!=''">#{status}</if>
            <if test="rejectReason!=null and rejectReason!=''">#{rejectReason}</if>
            <if test="createdAt!=null and createdAt!=''">#{createdAt}</if>
            <if test="updatedAt!=null and updatedAt!=''">#{updatedAt}</if>
        </trim>
    </insert>
    <update id="updateStatus" parameterType="com.qy.domain.pojo.AppointMentPojo">
        update appointments set
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="houseId!=null">house_id=#{houseId}</if>
            <if test="tenantId!=null">tenant_id=#{tenantId}</if>
            <if test="landlordId!=null">landlord_id=#{landlordId}</if>
            <if test="appointmentTime!=null and appointmentTime!=''">appointment_time=#{appointmentTime}</if>
            <if test="contactName!=null and contactName!=''">contact_name=#{contactName}</if>
            <if test="contactPhone!=null and contactPhone!=''">contact_phone=#{contactPhone}</if>
            <if test="remark!=null and remark!=''">remark=#{remark}</if>
            <if test="status!=null and status!=''">status=#{status}</if>
            <if test="rejectReason!=null and rejectReason!=''">reject_reason=#{rejectReason}</if>
            <if test="createdAt!=null and createdAt!=''">created_at=#{createdAt}</if>
            <if test="updatedAt!=null and updatedAt!=''">updated_at=#{updatedAt}</if>
        </trim>
        where id=#{id}
    </update>
    <select id="selectAppointMentByLandLordId" resultType="com.qy.domain.pojo.AppointMentPojo">
        select * from appointments where landlord_id=#{userId}
    </select>
</mapper>