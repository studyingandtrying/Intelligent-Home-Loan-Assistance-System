<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qy.mapper.house.MyUserMapper">

    <resultMap id="user" type="com.qy.domain.pojo.UserPojo">
        <result property="id" column="id"></result>
        <result property="username" column="username"></result>
        <result property="password" column="password"></result>
        <result property="role" column="role"></result>
        <result property="phone" column="phone"></result>
        <result property="avatar" column="avatar"></result>
        <result property="email" column="email"></result>
        <result property="realName" column="real_name"></result>
        <result property="idCard" column="id_card"></result>
        <result property="status" column="status"></result>
        <result property="createdAt" column="created_at"></result>
        <result property="updatedAt" column="updated_at"></result>
    </resultMap>
    <insert id="insertUserByUserPojo" parameterType="com.qy.domain.pojo.UserPojo">
        insert into user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="username!=null and username !=''">username,</if>
            <if test="password!=null and password !=''">password,</if>
            <if test="role!=null and role !=''">role,</if>
            <if test="phone!=null and phone !=''">phone,</if>
            <if test="avatar!=null and avatar !=''">avatar,</if>
            <if test="email!=null and email !=''">email,</if>
            <if test="realName!=null and real_name !=''">real_name,</if>
            <if test="idCard!=null and idCard !=''">idCard,</if>
            <if test="status!=null and status !=''">status,</if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="username!=null and username !=''">#{username},</if>
            <if test="password!=null and password !=''">#{password},</if>
            <if test="role!=null and role !=''">#{role},</if>
            <if test="phone!=null and phone !=''">#{phone},</if>
            <if test="avatar!=null and avatar !=''">#{avatar},</if>
            <if test="email!=null and email !=''">#{email},</if>
            <if test="realName!=null and real_name !=''">#{real_name},</if>
            <if test="idCard!=null and idCard !=''">#{id_card},</if>
            <if test="status!=null and status !=''">#{status},</if>
        </trim>
    </insert>

    <select id="selectUserByUserName" resultMap="user">
        select * from user where username=#{username}
    </select>
</mapper>